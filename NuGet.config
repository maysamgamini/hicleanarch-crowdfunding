<?xml version="1.0" encoding="utf-8"?>
<!-- Where packages come from. The BuildingBlocks come from the local feed, filled by
     "dotnet pack BuildingBlocks.slnx -o artifacts/packages"; everything else from nuget.org.
     A service that consumes the published packages instead signs in to CodeArtifact
     ("aws codeartifact login" with the dotnet tool, domain hicleanarch, repository packages),
     which adds a source named "hicleanarch/packages", and maps CrowdFunding.BuildingBlocks.* to it. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local" value="artifacts/packages" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="local">
      <package pattern="CrowdFunding.BuildingBlocks.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>

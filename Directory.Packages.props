<Project>
  <!-- Every package version is set here, once. Projects reference packages without a version. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- A version set here also wins when the package arrives indirectly, so EF Core is one version everywhere. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="AWSSDK.CognitoIdentityProvider" Version="4.0.106.4" />
    <PackageVersion Include="AWSSDK.SimpleEmailV2" Version="4.0.106.5" />
    <PackageVersion Include="AWSSDK.SimpleNotificationService" Version="4.0.100.21" />
    <PackageVersion Include="AWSSDK.SQS" Version="4.0.100.20" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="StackExchange.Redis" Version="3.4.5" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
    <PackageVersion Include="Npgsql.OpenTelemetry" Version="10.0.3" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.0" />
    <PackageVersion Include="Polly.Core" Version="8.8.1" />
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>
  <!-- The version every module is built and tested with. Upgrading is a change of its own.
       On a developer's machine, scripts/pack-buildingblocks.sh packs a fresh prerelease of it
       (<version>-local.<time>) and records it in this file, so a stale release is never restored from
       the package cache. CI and Docker images pack the release version itself into a clean feed. -->
  <Import Project="$(MSBuildThisFileDirectory)artifacts/packages/local-version.props"
          Condition="Exists('$(MSBuildThisFileDirectory)artifacts/packages/local-version.props')" />
  <PropertyGroup>
    <BuildingBlocksVersion Condition="'$(BuildingBlocksVersion)' == ''">6.0.0</BuildingBlocksVersion>
  </PropertyGroup>
  <ItemGroup Label="BuildingBlocks">
    <PackageVersion Include="CrowdFunding.BuildingBlocks.Application" Version="$(BuildingBlocksVersion)" />
    <PackageVersion Include="CrowdFunding.BuildingBlocks.Domain" Version="$(BuildingBlocksVersion)" />
    <PackageVersion Include="CrowdFunding.BuildingBlocks.Infrastructure" Version="$(BuildingBlocksVersion)" />
  </ItemGroup>
  <!-- The contract version of each module every consumer is built and tested with; the same rules as the
       BuildingBlocks. scripts/pack-contracts.sh packs fresh prereleases locally and records them in
       local-contracts-version.props; CI and the images pack each Contracts project's own version. -->
  <Import Project="$(MSBuildThisFileDirectory)artifacts/packages/local-contracts-version.props"
          Condition="Exists('$(MSBuildThisFileDirectory)artifacts/packages/local-contracts-version.props')" />
  <PropertyGroup>
    <CampaignsContractsVersion Condition="'$(CampaignsContractsVersion)' == ''">1.1.0</CampaignsContractsVersion>
    <PledgesContractsVersion Condition="'$(PledgesContractsVersion)' == ''">1.1.0</PledgesContractsVersion>
    <PaymentsContractsVersion Condition="'$(PaymentsContractsVersion)' == ''">1.0.0</PaymentsContractsVersion>
  </PropertyGroup>
  <ItemGroup Label="Contracts">
    <PackageVersion Include="CrowdFunding.Campaigns.Contracts" Version="$(CampaignsContractsVersion)" />
    <PackageVersion Include="CrowdFunding.Pledges.Contracts" Version="$(PledgesContractsVersion)" />
    <PackageVersion Include="CrowdFunding.Payments.Contracts" Version="$(PaymentsContractsVersion)" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.InMemory" Version="1.20.0" />
    <PackageVersion Include="Testcontainers" Version="4.15.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>
</Project>

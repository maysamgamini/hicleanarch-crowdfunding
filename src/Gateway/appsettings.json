{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "EdgeLimits": {
    "PerSecond": 20,
    "Burst": 40,
    "GatewayTasks": 2,
    "Valkey": "",
    "Webhook": {
      "PerSecond": 1000,
      "Burst": 1000
    }
  },
  "ReverseProxy": {
    "Routes": {
      "payments-webhook": {
        "ClusterId": "payments",
        "Order": 10,
        "Match": { "Path": "/v1/webhooks/psp", "Methods": [ "POST" ] },
        "Metadata": { "EdgeLimit": "Webhook" }
      },
      "payments-payment-method": {
        "ClusterId": "payments",
        "Order": 10,
        "Match": { "Path": "/v1/pledges/{id}/payment-method", "Methods": [ "PUT" ] }
      },
      "payments-confirm-payment": {
        "ClusterId": "payments",
        "Order": 10,
        "Match": { "Path": "/v1/pledges/{id}/confirm-payment", "Methods": [ "POST" ] }
      },
      "payments-settlement": {
        "ClusterId": "payments",
        "Order": 10,
        "Match": { "Path": "/v1/campaigns/{id}/settlement", "Methods": [ "GET" ] }
      },
      "notifications-preferences": {
        "ClusterId": "notifications",
        "Order": 10,
        "Match": { "Path": "/v1/me/notifications/{kind}", "Methods": [ "PUT" ] }
      },
      "api": {
        "ClusterId": "monolith",
        "Order": 100,
        "Match": { "Path": "/v1/{**rest}" }
      }
    },
    "Clusters": {
      "monolith": {
        "Destinations": {
          "monolith": { "Address": "http://localhost:5080/" }
        }
      },
      "payments": {
        "Destinations": {
          "payments": { "Address": "http://localhost:5080/" }
        }
      },
      "notifications": {
        "Destinations": {
          "notifications": { "Address": "http://localhost:5080/" }
        }
      }
    }
  }
}

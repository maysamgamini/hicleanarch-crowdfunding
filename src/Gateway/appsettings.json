{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "EdgeLimits": {
    "PerSecond": 20,
    "Burst": 40,
    "GatewayTasks": 2,
    "Valkey": ""
  },
  "ReverseProxy": {
    "Routes": {
      "api": {
        "ClusterId": "monolith",
        "Match": { "Path": "/v1/{**rest}" }
      }
    },
    "Clusters": {
      "monolith": {
        "Destinations": {
          "monolith": { "Address": "http://localhost:5080/" }
        }
      }
    }
  }
}

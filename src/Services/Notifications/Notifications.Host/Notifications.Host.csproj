<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The Notifications service: the Notifications module in a host of its own, made from templates/service. -->
  <PropertyGroup>
    <RootNamespace>CrowdFunding.Notifications.Host</RootNamespace>
    <AssemblyName>CrowdFunding.Notifications.Host</AssemblyName>
  </PropertyGroup>

  <!-- One module, and nothing of the others: they reach it through events and its contracts. -->
  <ItemGroup>
    <ProjectReference Include="..\Notifications\Notifications.csproj" />
    <ProjectReference Include="..\..\..\Platform\Messaging\Messaging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The same list of event consumers every host reads. -->
    <Content Include="..\..\..\..\events\subscriptions.json" Link="events\subscriptions.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\..\events\retired.json" Link="events\retired.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Label="BuildingBlocks">
    <PackageReference Include="CrowdFunding.BuildingBlocks.Infrastructure" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Payments.Host</RootNamespace>
    <AssemblyName>CrowdFunding.Payments.Host</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Payments, and nothing else of ours: the other modules are reached through their contracts. -->
    <ProjectReference Include="..\Payments.Infrastructure\Payments.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\Messaging\Messaging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The same list of event consumers every host reads. -->
    <Content Include="..\..\..\..\events\subscriptions.json" Link="events\subscriptions.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Label="BuildingBlocks">
    <PackageReference Include="CrowdFunding.BuildingBlocks.Application" />
  </ItemGroup>

</Project>

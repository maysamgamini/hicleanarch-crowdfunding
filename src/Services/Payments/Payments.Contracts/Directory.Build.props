<Project>
  <!-- Payments.Contracts is a package of its own (see src/ContractsPackage.props). The repository's settings come first. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- The one place this package's version is set. The snapshot test refuses a contract change without the bump SemVer asks for. -->
    <Version>1.0.0</Version>
    <Description>What the Payments module tells the others and accepts from them: saved cards, charge results, settlement, and the card-setup command over HTTP.</Description>
  </PropertyGroup>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('ContractsPackage.props', '$(MSBuildThisFileDirectory)../'))" />
</Project>

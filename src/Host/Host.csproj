<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>CrowdFunding.Host</RootNamespace>
    <AssemblyName>CrowdFunding.Host</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Npgsql.OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Modules\Campaigns\Campaigns.Infrastructure\Campaigns.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Pledges\Pledges.Infrastructure\Pledges.Infrastructure.csproj" />
    <!-- Of Payments, only its client: StartCardSetup over HTTP, on the Payments.Contracts package (s4-l10). -->
    <ProjectReference Include="..\Modules\Payments\Payments.Client\Payments.Client.csproj" />
    <ProjectReference Include="..\Modules\Notifications\Notifications.csproj" />
    <ProjectReference Include="..\Messaging\Messaging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Every host reads the same list of event consumers, events/subscriptions.json. -->
    <Content Include="..\..\events\subscriptions.json" Link="events\subscriptions.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Label="BuildingBlocks">
    <PackageReference Include="CrowdFunding.BuildingBlocks.Application" />
  </ItemGroup>

</Project>

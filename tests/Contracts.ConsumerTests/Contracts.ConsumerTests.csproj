<Project Sdk="Microsoft.NET.Sdk">

  <!-- The consumers' side: the modules as the two services compose them (Payments in its own since
       s4-l10), built against the published Contracts packages, and those packages' recorded examples,
       copied from the very versions restored. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Services\Pledges\Pledges.Host\Pledges.Host.csproj" />
    <ProjectReference Include="..\..\src\Services\Payments\Payments.Host\Payments.Host.csproj" />
    <!-- Campaigns' handlers ship only with its own service from s5-l09. An alias keeps its Program apart. -->
    <ProjectReference Include="..\..\src\Services\Campaigns\Campaigns.Host\Campaigns.Host.csproj" Aliases="CampaignsService" />
    <ProjectReference Include="..\..\src\Services\Notifications\Notifications.Host\Notifications.Host.csproj" Aliases="NotificationsService" />
    <ProjectReference Include="..\..\tools\ContractGate\ContractGate.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CrowdFunding.Campaigns.Contracts" GeneratePathProperty="true" />
    <PackageReference Include="CrowdFunding.Pledges.Contracts" GeneratePathProperty="true" />
    <PackageReference Include="CrowdFunding.Payments.Contracts" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(PkgCrowdFunding_Campaigns_Contracts)/contract/**/*.json" Link="contract/Campaigns/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(PkgCrowdFunding_Pledges_Contracts)/contract/**/*.json" Link="contract/Pledges/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(PkgCrowdFunding_Payments_Contracts)/contract/**/*.json" Link="contract/Payments/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
